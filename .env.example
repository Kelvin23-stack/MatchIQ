# Copy this file to .env for local development. NEVER commit .env.
# SERVER-ONLY variables. Do not add a VITE_ prefix: VITE_ variables are shipped to the browser.
HIGHLIGHTLY_API_KEY=your_key_here
# Comma-separated Highlightly league ids the app may use (the first is the default competition).
# Look the ids up with the provider (see SETUP.md, section 2). They are never hard-coded in the app.
HIGHLIGHTLY_LEAGUES=
# Optional default season (4-digit year). Leave blank to use the date-based default; override it in Settings if your plan needs another season.
HIGHLIGHTLY_SEASON=
